{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rootulp-portfolio",
  "compatibility_date": "2026-10-20",
  "build": {
    "command": "sh build.sh"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
