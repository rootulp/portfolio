#!/usr/bin/env bash
# Prepares a fresh Amp orb: installs JS dependencies so lint, build, and dev work immediately.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local start=$SECONDS
  echo "==> $*"
  "$@"
  echo "<== $* ($((SECONDS - start))s)"
}

# The repository uses Yarn classic (yarn.lock v1); the orb image ships it.
command -v yarn >/dev/null || step corepack enable

# Matches CI. Fast no-op when node_modules from a snapshot already matches yarn.lock.
step yarn install --frozen-lockfile --non-interactive --prefer-offline
