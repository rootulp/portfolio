#!/usr/bin/env bash
# Prepares a fresh Amp orb: installs wrangler so the site builds and serves immediately.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local start=$SECONDS
  echo "==> $*"
  "$@"
  echo "<== $* ($((SECONDS - start))s)"
}

# Matches CI.
step npm ci --no-audit --no-fund
